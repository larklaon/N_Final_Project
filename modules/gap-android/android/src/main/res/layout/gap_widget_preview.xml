<!-- Picker preview: the default size with a sample term question. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/gap_widget_card_bg" android:paddingTop="16dp" android:paddingBottom="16dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_gravity="center_vertical" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginStart="18dp" android:textColor="#FF7E877F" android:textSize="12sp" android:letterSpacing="0.12" android:text="네트워크" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
      android:background="@drawable/gap_band" android:orientation="vertical"
      android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="18dp" android:paddingBottom="18dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="3" android:ellipsize="end" android:fontFamily="serif" android:textStyle="bold"
        android:textColor="#FF121513" android:textSize="17sp" android:lineSpacingExtra="3sp" android:text="이것은 신뢰할 수 있는 순서 있는 바이트 스트림을 제공하는 전송 프로토콜이에요." />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:maxLines="3" android:ellipsize="end" android:textColor="#FF263A30"
        android:textSize="13sp" android:lineSpacingExtra="2sp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="12dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
      android:orientation="horizontal" android:visibility="gone">
      <Button style="@style/GapWidgetOx" android:text="O" />
      <Button style="@style/GapWidgetOx" android:layout_marginStart="10dp" android:text="X" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="12dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
      android:orientation="vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button style="@style/GapWidgetCell" android:text="UDP" />
        <Button style="@style/GapWidgetCell" android:text="TCP" android:layout_marginStart="8dp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button style="@style/GapWidgetCell" android:text="라우팅" />
        <Button style="@style/GapWidgetCell" android:text="TLS" android:layout_marginStart="8dp" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="4dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
      android:orientation="vertical" android:visibility="gone">
      <Button style="@style/GapWidgetRow" />
      <Button style="@style/GapWidgetRow" />
      <Button style="@style/GapWidgetRow" />
      <Button style="@style/GapWidgetRow" />
    </LinearLayout>
    <Button android:layout_width="match_parent" android:layout_height="48dp"
      android:layout_marginTop="12dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
      android:background="@drawable/gap_widget_next_bg" android:text="@string/gap_next" android:textAllCaps="false"
      android:textColor="#FF121513" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />
  </LinearLayout>
</FrameLayout>
