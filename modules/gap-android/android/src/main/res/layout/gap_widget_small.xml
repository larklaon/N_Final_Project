<!-- Small widget (one or two rows tall): the band with an O/X question, buttons beside it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/gap_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/gap_widget_card_bg" android:orientation="horizontal" android:gravity="center_vertical"
  android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingEnd="12dp">
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:background="@drawable/gap_band" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <TextView android:id="@+id/gap_widget_prompt" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:maxLines="2" android:ellipsize="end" android:fontFamily="serif" android:textStyle="bold"
      android:textColor="#FF121513" android:textSize="14sp" android:lineSpacingExtra="2sp" />
    <TextView android:id="@+id/gap_widget_feedback" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:maxLines="1" android:ellipsize="end" android:textColor="#FF263A30" android:textSize="12sp"
      android:visibility="gone" />
  </LinearLayout>
  <LinearLayout android:id="@+id/gap_widget_ox" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginStart="10dp" android:orientation="horizontal" android:visibility="gone">
    <Button android:id="@+id/gap_widget_o" style="@style/GapWidgetOxSmall" android:text="O" />
    <Button android:id="@+id/gap_widget_x" style="@style/GapWidgetOxSmall" android:layout_marginStart="6dp" android:text="X" />
  </LinearLayout>
  <Button android:id="@+id/gap_widget_next" android:layout_width="wrap_content" android:layout_height="52dp"
    android:layout_marginStart="10dp" android:minWidth="0dp" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:background="@drawable/gap_widget_next_bg" android:text="@string/gap_next" android:textAllCaps="false"
    android:textColor="#FF121513" android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />
</LinearLayout>
