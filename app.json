{
  "expo": {
    "name": "틈지식",
    "slug": "teum-knowledge",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/teum-icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/teum-icon.png",
        "backgroundColor": "#176B5B"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.teumknowledge.app",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "./plugins/withSiwcAndroid.js",
      "expo-font"
    ],
    "scheme": "teumknowledge",
    "platforms": [
      "android"
    ]
  }
}
