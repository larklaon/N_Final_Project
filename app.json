{
  "expo": {
    "name": "틈지식",
    "slug": "teum-knowledge",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/teum-icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/teum-icon.png",
        "backgroundColor": "#121513"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.teumknowledge.app",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "./plugins/withSiwcAndroid.js",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/hahmlet/700Bold/Hahmlet_700Bold.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-sans-kr/400Regular/IBMPlexSansKR_400Regular.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-sans-kr/500Medium/IBMPlexSansKR_500Medium.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-sans-kr/600SemiBold/IBMPlexSansKR_600SemiBold.ttf"
          ]
        }
      ],
      "expo-asset",
      "expo-web-browser"
    ],
    "scheme": "teumknowledge",
    "platforms": [
      "android"
    ]
  }
}
